# OS
.DS_Store
Thumbs.db
desktop.ini

# Screenshots captured by `kube-workspaces screenshot` during development.
*.png
# ...but the brand icon sources and the window-icon embed are not screenshots.
!assets/icon.png
!internal/viewer/icon.png
# ...nor the committed hicolor set the Linux packages install.
!packaging/linux/icons/**/*.png

# go-winres build output: the Windows .exe icon + version resources.
cmd/kube-workspaces/*.syso
cmd/kube-workspaces-web/*.syso

# Tier 1 media library builds (third_party/media-libs): the manifest,
# scripts and license texts are committed; fetched archives and
# build/stage outputs are reproducible artefacts.
third_party/media-libs/dl/
third_party/media-libs/out/
third_party/media-libs/stage/
