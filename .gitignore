.flatpak-builder/
*.exe
*.exe~
*.dll
*.so
*.dylib
/kube-workspaces
/agent-probe

# Updater transaction artefacts
.pending-update

# Test binary
*.test

# Python helper bytecode
__pycache__/
*.py[cod]

# Coverage
*.out
coverage.html

# Desktop build artefacts
*.app/
*.dmg
*.msi
*.pkg
*.deb
*.rpm
*.AppImage

# IDE
.idea
.vscode
*.swp
*.swo
*~

# Environment
.env
